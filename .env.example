# ──────────────────────────────────────────────
# Warhammer 40k Crusade AI — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────

# Application
APP_ID=crusade-ai
NODE_ENV=development
# Number of trusted reverse-proxy hops (e.g. 1 for Railway).
# Defaults to 1 in production when this var is unset.
# TRUST_PROXY_HOPS=1

# Session / JWT
JWT_SECRET=your-secret-here

# Database (TiDB / MySQL-compatible)
DATABASE_URL=mysql://user:password@host:4000/dbname
# TiDB Cloud TLS — set to the multi-line PEM CA cert for SSL (optional; omit for local dev)
# TIDB_CA_PEM=-----BEGIN CERTIFICATE-----
# MIIBxxx...
# -----END CERTIFICATE-----

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/oauth/github/callback

# LLM / Forge API (OpenAI-compatible endpoint)
BUILT_IN_FORGE_API_URL=https://your-llm-proxy/
BUILT_IN_FORGE_API_KEY=your-api-key

# Owner identifier (openId of the admin user)
OWNER_OPEN_ID=

# AWS S3 (optional — only needed for file storage features)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
